# EditorConfig: https://editorconfig.org

# Top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

# C++ specific settings
[*.{cpp,cc,cxx,h,hpp,hxx}]
indent_style = space
indent_size = 2
insert_final_newline = true

# Rust specific settings (standard rustfmt style)
[*.rs]
indent_style = space
indent_size = 4
max_line_length = 100
